# Unified Agent configuration for Mode 2 (WhitesourceXmlAntTask) probe.
#
# ant.resolveDependencies=true enables the Ant resolver so the scanner enters
# the three-mode evaluation chain at all.
#
# ant.ivyResolveDependencies=false because this probe has no ivy.xml — Mode 1
# is intentionally skipped.  Mode 2 fires (or falls back to Mode 3) based on
# the presence of the <whitesource> target in build.xml.
#
# ant.pathIdIncludes is left empty so Mode-3 fallback scans lib/** with the
# default extension list (jar, war, ear, ...).

ant.resolveDependencies=true
ant.ivyResolveDependencies=false
ant.pathIdIncludes=
